server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Proxy a la API: la app en producción usa apiUrl = '/api'.
    location /api/ {
        proxy_pass ${API_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Healthcheck: nunca en caché y sin ensuciar los logs.
    location = /health.json {
        access_log off;
        add_header Cache-Control "no-store";
        try_files $uri =404;
    }

    # Archivos con hash en el nombre: caché de larga duración.
    location ~* \.(?:js|css)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # index.html siempre fresco para tomar el último despliegue.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Fallback de SPA: las rutas de Angular se resuelven en el cliente.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
