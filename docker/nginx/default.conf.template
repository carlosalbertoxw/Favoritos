# Caché según el archivo servido. $uri ya es /index.html cuando se aplica el fallback de la SPA.
map $uri $cache_control {
    default            "";
    /index.html        "no-cache";
    /health.json       "no-store";
    "~*\.(?:js|css)$"  "public, max-age=31536000, immutable";
}

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # No revelar la versión de nginx en cabeceras ni páginas de error.
    server_tokens off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Un add_header dentro de un location anularía estos: usa el map para variar el Cache-Control.
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control $cache_control;

    # Proxy a la API: la app en producción usa apiUrl = '/api'.
    # ^~ evita que una regla de archivos estáticos capture rutas como /api/x.js.
    location ^~ /api/ {
        proxy_pass ${API_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Healthcheck: sin ensuciar los logs.
    location = /health.json {
        access_log off;
        try_files $uri =404;
    }

    # Fallback de SPA: las rutas de Angular se resuelven en el cliente.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
