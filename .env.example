# Copia este archivo como .env (junto a docker-compose.yml) para cambiar los valores por defecto.
# .env está en .gitignore: nunca lo versiones.

# Backend al que nginx reenvía /api/ (sin barra final).
# Con docker-compose.api.yml se ignora y se usa http://api:5000.
# Este es el valor por defecto de la imagen.
API_URL=http://host.docker.internal:5000

# Puerto de la máquina anfitriona donde se publica la app.
WEB_PORT=8090

# Red de Docker de Api-restful-favoritos (solo con docker-compose.api.yml).
API_NETWORK=api-restful-favoritos_default
